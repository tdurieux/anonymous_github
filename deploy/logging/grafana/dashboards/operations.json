{
  "uid": "anonymous-operations",
  "title": "Anonymous GitHub operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "operations"
  ],
  "templating": {
    "list": [
      {
        "name": "request_id",
        "label": "Request UUID",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "job_id",
        "label": "Job UUID",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "edge_id",
        "label": "Edge request ID",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Failures and cancellations",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "severity:error OR event:request_cancelled",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "First byte versus transfer time",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "event:request* | stats by (service, route) quantile(0.95, firstByteMs) as first_byte_p95_ms, quantile(0.95, responseMs) as transfer_p95_ms",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "title": "Request stages",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "event:request* | stats by (service) avg(stage_upstream_ms) as upstream_ms, avg(stage_worker_wait_ms) as worker_wait_ms, avg(stage_anonymize_ms) as anonymize_ms",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "title": "Traffic and rate limits",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:nginx | stats by (status, limit_req_status) count() as requests",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "Authentication versus upstream failures",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "errorCode:* OR status:401 OR status:403 OR status:>=500 | stats by (service, errorCode, status) count() as events",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "title": "Release comparison",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:api outcome:completed | stats by (release) count() as requests, count() if (status:>=500) as server_errors, quantile(0.95, firstByteMs) as first_byte_p95_ms",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "title": "Crashes and restarts",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "event:process_fatal_error OR event:process_started",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "title": "Queue stalls and failures",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "event:job_stalled OR event:job_failed OR event:queue_heartbeat",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 9,
      "title": "Memory and lost application logs",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "event:process_heartbeat | stats by (service, instance) max(rss) as rss, max(memoryRatio) as memory_ratio, max(droppedLogs) as dropped_logs",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 10,
      "title": "Request correlation",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "requestId:=\"$request_id\"",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 11,
      "title": "Job correlation",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jobId:=\"$job_id\"",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 12,
      "title": "Edge to application correlation",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "anonymous-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "edge_request_id:=\"$edge_id\" OR requestId:=\"$request_id\"",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 20,
      "title": "Storage bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "logging-health"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vl_data_size_bytes)"
        }
      ]
    },
    {
      "id": 21,
      "title": "Free disk bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "logging-health"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(vl_free_disk_space_bytes)"
        }
      ]
    },
    {
      "id": 22,
      "title": "Collector discarded events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "logging-health"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(vector_buffer_discarded_events_total[5m])) or vector(0)) + (sum(rate(vector_component_discarded_events_total{intentional!=\"true\"}[5m])) or vector(0))"
        }
      ]
    },
    {
      "id": 23,
      "title": "Firing alerts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "logging-health"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}"
        }
      ]
    }
  ]
}
