{
  "name": "@tdurieux/anonymous_github",
  "version": "2.3.0",
  "description": "Anonymise Github repositories for double-anonymous reviews",
  "bin": {
    "anonymous_github": "build/cli/index.js"
  },
  "scripts": {
    "test": "mocha --reporter spec",
    "coverage": "c8 --all --reporter=text --reporter=html --include='src/core/**/*.ts' --include='src/server/routes/**/*.ts' --include='src/config.ts' --exclude='src/**/*.d.ts' --exclude='src/core/model/**' npm test",
    "coverage:lcov": "c8 --all --reporter=lcov --include='src/core/**/*.ts' --include='src/server/routes/**/*.ts' --include='src/config.ts' --exclude='src/**/*.d.ts' --exclude='src/core/model/**' npm test",
    "lint": "eslint .",
    "start": "node --inspect=5858 -r ts-node/register ./src/server/index.ts",
    "dev": "node --watch -r ts-node/register ./src/server/index.ts",
    "dev:ui": "node scripts/dev-proxy.js",
    "build": "rm -rf build && tsc && node gulpfile.js",
    "knip": "knip",
    "migrate:credentials": "node -r ts-node/register src/scripts/migrate-credentials.ts",
    "recover:owners": "node -r ts-node/register src/scripts/recover-repository-owners.ts",
    "migrate:performance": "node -r ts-node/register src/scripts/create-performance-indexes.ts",
    "test:performance": "mocha test/performance-*.test.js",
    "benchmark:performance": "node scripts/performance-benchmark.js",
    "build:ui": "node gulpfile.js",
    "test:ui": "npm run build:ui && mocha test/frontend-regressions.test.js test/dashboard-ui.test.js test/vue-ui.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdurieux/anonymous_github.git"
  },
  "author": "Thomas Durieux",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/tdurieux/anonymous_github/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/tdurieux"
  },
  "homepage": "https://github.com/tdurieux/anonymous_github#readme",
  "files": [
    "public",
    "build"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1147.0",
    "@mongodb-js/zstd": "^1.2.2",
    "@octokit/plugin-throttling": "^8.2.0",
    "@octokit/rest": "^20.1.2",
    "@smithy/node-http-handler": "^4.12.1",
    "archiver": "^7.0.1",
    "bullmq": "^5.81.5",
    "cacheable-lookup": "^6.1.0",
    "compression": "^1.8.2",
    "connect-redis": "^10.0.0",
    "crypto-js": "^4.2.0",
    "decompress-stream-to-s3": "^2.1.1",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-slow-down": "^3.1.1",
    "got": "^11.8.6",
    "inquirer": "^8.2.7",
    "isbinaryfile": "^5.0.7",
    "marked": "^15.0.12",
    "mime-types": "^3.0.2",
    "mongoose": "^7.8.12",
    "node-schedule": "^2.1.1",
    "parse-github-url": "^1.0.4",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "rate-limit-redis": "^6.0.1",
    "re2js": "^2.8.6",
    "redis": "^5.12.1",
    "sanitize-html": "^2.18.0",
    "ts-custom-error": "^3.3.1",
    "unzip-stream": "^0.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/compression": "^1.8.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/inquirer": "^8.2.13",
    "@types/mime-types": "^3.0.1",
    "@types/node-schedule": "^2.1.8",
    "@types/parse-github-url": "^1.0.3",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/sanitize-html": "^2.16.2",
    "@types/unzip-stream": "^0.3.4",
    "c8": "^12.0.0",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-uglify": "^3.0.2",
    "http-proxy-middleware": "^4.2.0",
    "jsdom": "^29.1.1",
    "knip": "^6.40.0",
    "mocha": "^12.0.3",
    "ordered-read-streams": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vinyl-fs": "^4.0.2"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  }
}
